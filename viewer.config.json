{
  "$schema_version": "1.0",
  "mode": "directory",
  "profile": "gallery-tests",
  "profiles": {
    "gallery-tests": {
      "description": "Visualize kernel-app Gallery outputs via data directory.",
      "url_prefix": "/kernel-data",
      "manifest_path": "manifest.json",
      "data_root": "../kernel-app/data"
    },
    "mock-demo": {
      "description": "Read built-in mock fixtures (no kernel-app dependency).",
      "url_prefix": "/mock-data",
      "manifest_path": "manifest.json",
      "data_root": "./src/mock"
    }
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8090,
    "ingest_path": "/ingest",
    "viewer_path": "/viewer"
  }
}